<html xmlns="http://www.w3.org/1999/xhtml"
        xml:lang="en"
        xmlns:tal="http://xml.zope.org/namespaces/tal"
        xmlns:metal="http://xml.zope.org/namespaces/metal"
        metal:use-macro="backend"
        i18n:domain="c3smembership">
    <tal:block metal:fill-slot="content">
        <h1>Membership Dues</h1>

        <!--! Notice shown once the clock reaches a not-yet-configured year -->
        <tal:block tal:condition="next_dues_year">
            <div tal:condition="next_dues_year_templates_ready"
                    class="alert alert-warning" role="alert">
                <strong>Dues year ${next_dues_year} has begun.</strong>
                The invoice templates are present. To enable it, set
                <code>LATEST_DUES_YEAR = ${next_dues_year}</code> in
                <code>c3smembership/presentation/views/dues_years.py</code>
                and redeploy.
            </div>
            <div tal:condition="python: not next_dues_year_templates_ready"
                    class="alert alert-danger" role="alert">
                <strong>Dues year ${next_dues_year} has begun</strong>, but its
                invoice templates are missing in
                <code>${next_dues_year_template_dir}</code>. Add the following,
                then set <code>LATEST_DUES_YEAR = ${next_dues_year}</code> and
                redeploy:
                <ul>
                    <li tal:repeat="template_name next_dues_year_missing">
                        <code>${template_name}</code>
                    </li>
                </ul>
            </div>
        </tal:block>

        <p tal:repeat="year dues_years">
            <a href="${request.route_url('dues{0}_listing'.format(year % 100))}"
                    class="btn btn-primary">
                List of Dues Invoices for ${year}
            </a>
        </p>
        <p>
            <a href="${request.route_url('batch_archive_pdf_invoices')}" class="btn btn-secondary">
                Dues invoices archiving
            </a>
        </p>
        <h2>Mail Invoices for Membership Dues ${latest_dues_year}</h2>
        <p tal:define="batch_route python: 'send_dues{0}_invoice_batch'.format(latest_dues_year % 100)">
            <a href="${request.route_url(batch_route, number=5)}"
                    title="Send 5 Invoices for Membership Dues"
                    class="btn btn-primary">
                Send 5 Invoices for Membership Dues
            </a>
        </p>
        <p tal:define="batch_route python: 'send_dues{0}_invoice_batch'.format(latest_dues_year % 100)">
            Send a specific number of invoices at once:
            <form method='POST' action="${request.route_url(batch_route, number='foo')}">
                <input type='text' name='number' placeholder='123'></input>
                <input type='submit' name='submit' value="Send"></input>
            </form>
        </p>
    </tal:block>
</html>
