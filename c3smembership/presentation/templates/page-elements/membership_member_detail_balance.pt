<!--! i18n needs one root element -->
<div tal:omit-tag="">
<h2 id="certificate">Account Balance</h2>
<table class="table table-striped">
    <tr>
        <th>Position</th>
        <th>Amount</th>
    </tr>
    <tr>
        <?python
            balance = sum(d['balance'] or 0 for d in dues)
            balanced = (balance == 0)
            negative_balance = (-balance < 0)
            positive_balance = (-balance > 0)
        ?>
        <th>Account balance</th>
        <th tal:condition="not balanced and negative_balance" class="alert alert-danger">
            ${-balance}
        </th>
        <th tal:condition="not balanced and positive_balance" class="alert alert-warning">
            +${-balance}
        </th>
        <th tal:condition="balanced" class="alert alert-success">
            ${-balance}
        </th>
    </tr>
    <!-- one row per dues year (descending) -->
    <tr tal:repeat="d dues">
        <td>Membership dues ${d['year']}</td>
        <td>${-(d['balance'] or 0)}</td>
    </tr>
</table>
</div>
